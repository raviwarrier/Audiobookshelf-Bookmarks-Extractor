# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Audiobookshelf Server URL (ABS_TARGET_SERVER or ABS_SERVER_URL, e.g. http://localhost:13378 or http://audiobookshelf:80)
ABS_TARGET_SERVER="http://localhost:13378"
ABS_SERVER_URL="http://localhost:13378"

# Path where snippets and markdown transcripts will be saved
SNIPPETS_DIR="/data/snippets"
VOLUME_DIR="/data"

# Host path where audiobooks are stored (used to translate Docker container /audiobooks to host disk)
AUDIOBOOKS_PATH="/srv/ssd/Bookshelf/Audiobooks"
# Optional container:host path mappings (comma-separated)
PATH_MAPPINGS="/audiobooks:/srv/ssd/Bookshelf/Audiobooks,/summaries:/srv/ssd/Bookshelf/Summaries"

# Port Configuration
# Web Dashboard & Express server port (Default: 13379 in production / PM2; 3000 in AI Studio dev preview)
PORT=13379

# Python Sidecar & Interceptor Proxy port (Default: 13380)
SIDECAR_PORT=13380
